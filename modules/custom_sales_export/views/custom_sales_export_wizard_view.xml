<odoo>
    <record id="custom_sales_export_form" model="ir.ui.view">
        <field name="name">custom.sales.export.form</field>
        <field name="model">custom.sales.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p>Select sales date interval.</p>
                <group>
                    <field name="date_from"></field>
                    <field name="date_to"></field>
                </group>
                <group col="1">
                    <field name="name_sales_orders" invisible="True"/>
                    <field name="name_sales_orders_lines" invisible="True"/>
                    <!-- Invisible separated to hide only csv cleared, not both -->
                    <field 
                        name="file_sales_orders" 
                        filename="name_sales_orders" 
                        invisible="not file_sales_orders"
                    /> 
                    <field 
                        name="file_sales_orders_lines" 
                        filename="name_sales_orders_lines" 
                        invisible="not file_sales_orders_lines"
                    />
                </group>
                <footer>
                    <button name="action_export_to_csv" string="Export" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>